{
  "name": "drag-and-drop-plugin",
  "version": "1.0.7",
  "description": "A lightweight drag-and-drop plugin for web applications.",
  "scripts": {
    "serve": " webpack serve --config webpack.dev.js",
    "build:types": "tsup && rm -f dist/*.js dist/*.css",
    "build": "webpack --config webpack.dev.js",
    "build:prod": "rm -rf dist && npm run build:types && webpack --config webpack.prod.js",
    "publish": "npm run build:prod && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walunjakarsachinedu/drag-and-drop-plugin.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "drag-and-drop",
    "drag",
    "drop",
    "plugin",
    "javascript",
    "typescript",
    "web",
    "ui"
  ],
  "author": "Sachin Walunjakar",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "raw-loader": "^4.0.2",
    "style-loader": "^4.0.0",
    "to-string-loader": "^1.2.0",
    "ts-loader": "^9.5.1",
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}